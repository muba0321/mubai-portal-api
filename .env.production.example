# SRE Portal 生产环境配置模板
# 服务器部署时复制此文件为 .env.production 并填入真实值：
#   cp .env.production.example .env.production
#   # 然后编辑 .env.production 填入真实密钥和数据库地址

# 应用环境
FLASK_ENV=production

# 数据库连接
# Docker 部署（容器同网络）：使用容器名 sre-portal-mysql
# 直连外部数据库：使用 IP 地址
DATABASE_URL=mysql+pymysql://root:YOUR_DB_PASSWORD@MYSQL_HOST:3306/sre_portal?charset=utf8mb4

# Flask 密钥（生产环境务必修改为随机字符串）
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Token 过期时间（秒）
JWT_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800

# AI 模型配置（通义千问 DashScope Coding Plan，用于自然语言转 SQL）
# API Key 获取地址：https://dashscope.console.aliyun.com/apiKey
# Coding Plan Key 以 sk-sp- 开头，使用 coding.dashscope.aliyuncs.com 端点
AI_API_KEY=sk-sp-your-api-key-here
AI_MODEL=qwen3.5-plus
