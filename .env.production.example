# SRE Portal 生产环境配置
# 复制此文件为 .env 并修改对应值

# 数据库连接
DATABASE_URL=mysql+pymysql://root:huanxin0321@154.12.54.207:3306/sre_portal

# Flask 密钥（生产环境务必修改为随机字符串）
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Token 过期时间（秒）
JWT_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800

# Docker 镜像标签（可选，默认使用 latest）
IMAGE_TAG=latest

# AI 模型配置（通义千问 DashScope，用于自然语言转 SQL）
# API Key 获取地址：https://dashscope.console.aliyun.com/apiKey
AI_API_KEY=sk-your-api-key-here
AI_MODEL=qwen-coder-plus
